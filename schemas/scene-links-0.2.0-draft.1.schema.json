{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "0.2.0-draft.1"
    },
    "catalogue": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "requirement_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "kind": {
            "enum": [
              "site",
              "natural_object"
            ]
          }
        },
        "required": [
          "id",
          "requirement_id",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "catalogue_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          }
        },
        "required": [
          "id",
          "catalogue_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128
    },
    "roads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "requirement_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          }
        },
        "required": [
          "id",
          "requirement_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "interior_spaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "requirement_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "site_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          }
        },
        "required": [
          "id",
          "requirement_id",
          "site_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 256
    },
    "natural_objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          },
          "catalogue_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,47}$"
          }
        },
        "required": [
          "id",
          "catalogue_id"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1024
    }
  },
  "required": [
    "contract_version",
    "catalogue",
    "sites",
    "roads",
    "interior_spaces",
    "natural_objects"
  ],
  "additionalProperties": false
}
