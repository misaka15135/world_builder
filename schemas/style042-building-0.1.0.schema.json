{
  "type": "object",
  "properties": {
    "site_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,47}$"
    },
    "concept": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "storeys": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "storey_height_m": {
