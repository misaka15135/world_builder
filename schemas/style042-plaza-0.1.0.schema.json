    },
    "concept": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "benches": {
      "type": "integer",
      "minimum": 2,
      "maximum": 4
    },
    "lamps": {
      "type": "integer",
      "minimum": 2,
      "maximum": 4
    },
    "trees": {
      "type": "integer",
      "minimum": 2,
      "maximum": 4
    },
    "fountain": {
      "const": true
    }
  },
  "required": [
    "site_id",
    "concept",
    "benches",
    "lamps",
    "trees",
    "fountain"
  ],
  "additionalProperties": false
}
