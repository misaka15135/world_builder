# Python and local tooling
__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp_*/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
.venv-desktop/
dist/
build/
venv/

# User API configuration, credentials and model run transcripts stay local.
.env
.env.*
config/agents.local.json
artifacts/agent-runs/

# Local generated repositories and content-addressed resources
artifacts/**/wir.sqlite3
artifacts/**/assets/
artifacts/**/runs/
artifacts/pytest-*/
artifacts/benchmark-pilot-v1/*/
artifacts/benchmark-pilot-v2/*/
artifacts/benchmark-pilot-v3/*/
artifacts/benchmark-city-v1/*/
